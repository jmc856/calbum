# Copy to .env and fill in real values yourself (do not paste secrets in chat).
# .env is gitignored — never commit it.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Filled in automatically by scripts/get_refresh_token.py — leave blank for now.
SPOTIFY_REFRESH_TOKEN=

# Personal access token from discogs.com/settings/developers. Used by Stage 1
# (calbum.enrich) for the Discogs-by-barcode / Discogs-by-search cascade.
DISCOGS_TOKEN=

# Used by Stage 2 (calbum.sheets). See PLAN.md Prereqs:
# - GOOGLE_SA_JSON_B64: entire downloaded service-account JSON key,
#   base64-encoded (NOT raw JSON — the private_key field's embedded \n
#   sequences get corrupted by dotenv/shell unescaping otherwise). Share the
#   target Sheet with the key's client_email as Editor.
#     python3 -c "import json,base64; print(base64.b64encode(json.dumps(json.load(open('/path/to/key.json'))).encode()).decode())"
# - SHEET_ID: the id segment from the Sheet's URL
#   (https://docs.google.com/spreadsheets/d/SHEET_ID/edit).
GOOGLE_SA_JSON_B64=
SHEET_ID=
